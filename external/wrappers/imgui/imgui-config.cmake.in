@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SDL3 @SDL3_VERSION_REQUIRED@ CONFIG)
# SDL3 exports its headers as non-system. They share an include prefix with ImGui, and a non-system
# -I for that prefix would override -isystem and expose ImGui headers to consumer warnings.
if(TARGET SDL3::Headers)
  set_property(TARGET SDL3::Headers PROPERTY SYSTEM TRUE)
endif()
include(${CMAKE_CURRENT_LIST_DIR}/imgui-targets.cmake)
check_required_components(imgui)
