{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "assigneesFromCodeOwners": false,
  "schedule": ["after 3am and before 6am on monday"],
  "timezone": "UTC",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(CATCH2_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "catchorg/Catch2",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(BENCHMARK_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "google/benchmark",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(FTXUI_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "ArthurSonzogni/FTXUI",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(FREETYPE_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "freetype/freetype",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^VER-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(SDL3_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "libsdl-org/SDL",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^release-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(SDL3_TTF_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "libsdl-org/SDL_ttf",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^release-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(LZ4_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "lz4/lz4",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(ROBIN_MAP_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "Tessil/robin-map",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^external/third_party_versions\\.cmake$"],
      "matchStrings": ["set\\(NANOBIND_VERSION_REQUIRED\\s+(?<currentValue>[^\\s\\)]+)\\)"],
      "depNameTemplate": "wjakob/nanobind",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "groupName": "third-party dependencies",
      "branchTopic": "third-party-dependencies",
      "commitMessageTopic": "third-party dependencies",
      "commitMessagePrefix": "chore(deps):",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "prCreation": "immediate"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "python3 external/scripts/update_third_party_sources.py --sync-archives --prune --strict"
    ],
    "fileFilters": [
      "external/third_party_versions.cmake",
      "external/sources/*.tar.gz"
    ],
    "executionMode": "update"
  }
}
